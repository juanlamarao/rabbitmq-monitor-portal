# Copie para .env.local. Este arquivo deve ficar FORA do Git.
APP_ENV=development
MYSQL_DATABASE=rabbitmq_monitor_portal
MYSQL_USER=app
MYSQL_PASSWORD=portal_dev_mysql_only
MYSQL_ROOT_PASSWORD=portal_dev_root_only
RABBITMQ_USERNAME=portal
RABBITMQ_PASSWORD=portal_dev_rabbit_only
RABBITMQ_DATADOG_PASSWORD=unused_prometheus_scrape
LDAP_ADMIN_PASSWORD=admin_local_dev
LDAP_CONFIG_PASSWORD=config_local_dev
LOCAL_ADMIN_PASSWORD_HASH=
CREDENTIAL_ENCRYPTION_KEY=
PORTAL_PUBLIC_BASE_URL=http://localhost:3000
# Trial US1: datadoghq.com; EU: datadoghq.eu; confira a região da sua organização
DD_SITE=datadoghq.com
DD_API_KEY=

# Grupos Entra consultados via Microsoft Graph (User.Read delegado)
ENTRA_GROUPS_SOURCE=graph
ENTRA_GRAPH_SCOPES=User.Read
ENTRA_GROUPS_CACHE_TTL=300

# Grupo Entra Observability: configuração de clusters (não equivale ao Admin global)
ENTRA_OBSERVABILITY_GROUP_ID=
ENTRA_OBSERVABILITY_APP_ROLE=Portal.Observability
