# VARIÁVEIS PARA AZURE DEVOPS LIBRARY — RabbitMQ Monitor Portal 0.5.5_minorFix
# Cada linha segue a convenção NOME=valor. Não é importação automática do Variable Group.
# Na pipeline, o token é __RBTMQ_PORTAL_<NOME>__ e deve ser substituído antes do kubectl apply.
# Os ambientes DEV/UAT/PROD devem ter seus PRÓPRIOS Variable Groups/valores.
# Os valores entre <...> são EXEMPLOS, não credenciais reais.
# Não cadastrar as imagens do portal na Library: ImageName1 e ImageName2 são trocadas pelo template corporativo.
# Segredos em Variables Group marcados como secret; a pipeline deve mascarar e não publicar o YAML resolvido.
# Se a senha tiver aspas duplas (") ou barras invertidas (\), garantir escape YAML correto no replace.
# Não altere a CREDENTIAL_ENCRYPTION_KEY de um ambiente já em uso.

# --- Ambiente DEV ---
RBTMQ_PORTAL_CREDENTIAL_ENCRYPTION_KEY=<chave-Fernet-fixa-ja-utilizada-no-ambiente>
RBTMQ_PORTAL_ENTRA_CLIENT_ID=<application-client-id-guid>
RBTMQ_PORTAL_ENTRA_CLIENT_SECRET=<definir-na-library-como-secret>
RBTMQ_PORTAL_ENTRA_REDIRECT_URI=https://rabbitmq-monitor-dev.empresa.interno/api/auth/entra/callback
RBTMQ_PORTAL_ENTRA_TENANT_ID=<tenant-guid>
RBTMQ_PORTAL_INGRESS_CLASS=nginx
RBTMQ_PORTAL_INGRESS_HOST=rabbitmq-monitor-dev.empresa.interno
RBTMQ_PORTAL_LDAP_BIND_DN=svc-rabbitmq-portal@empresa.interno
RBTMQ_PORTAL_LDAP_BIND_PASSWORD=<definir-na-library-como-secret>
RBTMQ_PORTAL_LDAP_HOST=ad.empresa.interno
RBTMQ_PORTAL_LDAP_PORT=636
RBTMQ_PORTAL_LDAP_REQUIRE_ORG_UNIT=true
RBTMQ_PORTAL_LDAP_SEARCH_BASE=DC=empresa,DC=interno
RBTMQ_PORTAL_LDAP_START_TLS=false
RBTMQ_PORTAL_LDAP_USE_SSL=true
RBTMQ_PORTAL_LOCAL_ADMIN_PASSWORD_HASH=<hash-Argon2id-definir-como-secret>
RBTMQ_PORTAL_MYSQL_IMAGE=mysql:8.4
RBTMQ_PORTAL_MYSQL_PASSWORD=<definir-na-library-como-secret>
RBTMQ_PORTAL_MYSQL_ROOT_PASSWORD=<definir-na-library-como-secret>
RBTMQ_PORTAL_NAMESPACE=rabbitmq-monitor-dev
RBTMQ_PORTAL_REDIS_IMAGE=redis:7.4-alpine
