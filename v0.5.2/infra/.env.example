APP_NAME=RabbitMQ Monitor Portal
APP_ENV=development
APP_DEBUG=true

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=rabbitmq_monitor_portal
MYSQL_USER=app
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

LDAP_HOST=ldap
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=example,dc=local
LDAP_BIND_PASSWORD=admin
LDAP_SEARCH_BASE=ou=People,dc=example,dc=local
LDAP_USE_SSL=false
DIRECTORY_CACHE_REFRESH_INTERVAL_SECONDS=3600
DISCOVERY_SCHEDULER_INTERVAL_SECONDS=300
REMOVED_QUEUE_CLEANUP_INTERVAL_SECONDS=86400
REMOVED_QUEUE_RETENTION_DAYS=60

RABBITMQ_DEMO_HOST=rabbitmq
RABBITMQ_DEMO_PORT=15672
RABBITMQ_DEMO_USERNAME=guest
RABBITMQ_DEMO_PASSWORD=guest

VITE_API_BASE_URL=http://localhost:8000

# Opcional, mas recomendado fora do ambiente local. Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

PORTAL_PUBLIC_BASE_URL=http://localhost:3000
