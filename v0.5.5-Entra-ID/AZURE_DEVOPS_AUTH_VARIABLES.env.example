# Azure DevOps Library (do not commit resolved secrets into source control)
# Existing values such as MYSQL_PASSWORD, CREDENTIAL_ENCRYPTION_KEY and images remain unchanged
ENTRA_TENANT_ID=<GUID-do-tenant>
ENTRA_CLIENT_ID=<GUID-do-app-registration>
ENTRA_CLIENT_SECRET=<client-secret-da-app-secret>
ENTRA_REDIRECT_URI=https://rabbitmq-monitor-dev.exemplo.interno/api/auth/entra/callback
LOCAL_ADMIN_PASSWORD_HASH=<hash-argon2id-da-senha-de-emergencia>
LDAP_HOST=ad.empresa.interno
LDAP_PORT=636
LDAP_BIND_DN=conta-leitura@empresa.interno
LDAP_BIND_PASSWORD=<senha-do-usuario-de-leitura>
LDAP_SEARCH_BASE=DC=empresa,DC=interno
LDAP_USE_SSL=true
LDAP_START_TLS=false
LDAP_REQUIRE_ORG_UNIT=true
# LDAP_REQUIRE_ORG_UNIT=false aceita pessoas mesmo com division e department vazios
# A query LDAP é (&(objectClass=user)(objectCategory=person))
# Adicione no Azure: App Registration -> Token Configuration -> groups claim = Object ID
# Entra Admin App Role configurado no deployment = Portal.Admin
