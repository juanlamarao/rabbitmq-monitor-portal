# Build context: repository root (.)
FROM node:22-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/tsconfig.json frontend/vite.config.ts frontend/index.html ./
# Build-time compatibility for corporate registries with untrusted/intercepted TLS.
# In controlled CI, use --build-arg NPM_STRICT_SSL=true when the CA is installed.
ARG NPM_STRICT_SSL=false
RUN npm_config_strict_ssl="$NPM_STRICT_SSL" npm install
COPY frontend/src/ ./src/
COPY frontend/public/ ./public/
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
COPY frontend/nginx.k8s.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
